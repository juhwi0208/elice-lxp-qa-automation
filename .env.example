# ==================================================
# Triple Q QA 자동화 환경변수
# 사용법: Copy-Item .env.example .env
# 실제 토큰·비밀번호는 .env 또는 CI 비밀변수에만 입력한다.
# ==================================================


# --------------------------------------------------
# 1. 공통 QA 환경
# --------------------------------------------------

# 기관 식별자
LXP_ORG_NAME_SHORT=academy

# QA 6기 1팀 전용 클래스 ID (API와 E2E 기능 테스트 실행 시 필요)
LXP_CLASSROOM_ID=28f79a10-c14b-4531-9feb-53d9a5c157fc
LXP_BOARD_ARTICLE_ID=


# --------------------------------------------------
# 2. 서비스 주소
# --------------------------------------------------

# API 자동화
LXP_API_BASE_URL=https://dev-qatrack-api.dev.elicer.io
# 게시판 등 기존 레거시 엔드포인트가 별도 호스트를 사용할 때만 설정한다.
LXP_LEGACY_API_BASE_URL=

# API 자동 로그인 토큰 발급
LXP_ACCOUNT_API_BASE_URL=https://dev-qatrack-account-api.dev.elicer.io

# 학습과목 API 자동화
LXP_CLASSROOM_API_BASE_URL=https://dev-qatrack-classroom-api.dev.elicer.io
LXP_COURSE_API_BASE_URL=https://dev-qatrack-course-api.dev.elicer.io
LXP_DASHBOARD_API_BASE_URL=https://dev-qatrack-dashboard-api.dev.elicer.io

# 브라우저 로그인
LXP_ACCOUNTS_BASE_URL=https://dev-qatrack-accounts.dev.elicer.io

# 로그인 이후 이동할 웹 서비스
LXP_WEB_BASE_URL=https://dev-qatrack-web.dev.elicer.io


# --------------------------------------------------
# 3. API 자동화 인증 토큰
# --------------------------------------------------

# Bearer 접두사를 제외한 토큰 원문을 입력한다.
LXP_LEARNER_TOKEN=
LXP_EDUCATOR_TOKEN=
LXP_OTHER_LEARNER_TOKEN=


# --------------------------------------------------
# 4. E2E 로그인 계정
# --------------------------------------------------

LXP_LEARNER_EMAIL=qa6_final_st01@example.com
LXP_LEARNER_PASSWORD=

LXP_EDUCATOR_EMAIL=qa6_final_tc01@example.com
LXP_EDUCATOR_PASSWORD=

# 두 번째 학습자 계정
LXP_OTHER_LEARNER_EMAIL=
LXP_OTHER_LEARNER_PASSWORD=


# Selenium 실행 브라우저와 선택적 ChromeDriver 고정 경로
LXP_SELENIUM_BROWSER=chrome
LXP_CHROMEDRIVER_PATH=

# 학습과목 API·E2E 공용 Dummy 데이터
LXP_COURSE_NAME=SANDBOX
LXP_TEST_LECTURE_NAME=TEST
# QA 6기 1팀 SANDBOX 과목과 TEST 수업 ID
LXP_COURSE_ID=727
# 주관식 테스트일 때 입력할 QA 전용 답안(객관식이면 비워 둠)
LXP_TEST_ANSWER=

# 권한·인증 경계 API 전용 ID (QA 담당자가 검증한 값만 입력)
# TC100 재현용 비공개 QA 과목. 현재 학습자 상세 조회가 허용되어 결함 후보로 관리한다.
LXP_PRIVATE_COURSE_ID=830
# TEST 수업의 QUIZ 자료 ID와 검증 대상 학습자의 조직 사용자 ID
# 학습자 시험 상태가 Ready이면 QUIZ 조회가 ready_test_admission_status(409)로 제한된다.
# 로그인 JWT·클래스룸 account_id가 아니라 학습자 프로필의 userId를 입력한다.
LXP_MATERIAL_QUIZ_ID=1327
# TC91 전용: 학습자가 접근 가능하고 기존 응답이 없는 전용 QA 퀴즈 ID
LXP_TC91_MATERIAL_QUIZ_ID=2763
LXP_LEARNER_USER_ID=305
# 현재 QA 객관식 퀴즈는 resource_id=null이다. 다른 유형에서 실제 양의 정수가 확인된 경우에만 입력한다.
LXP_QUIZ_RESOURCE_ID=
# API에 전달할 JSON 형식의 답안. 현재 QA 객관식 QUIZ의 첫 번째 선택지 답안이다.
LXP_QUIZ_ANSWER=[0]

# 수업 자료 조회 API 전용 ID (locator_type: 0=Main, 1=Sub)
LXP_LECTURE_ID=1581
LXP_LECTURE_PAGE_ID=1327
LXP_LECTURE_LOCATOR_TYPE=0

# 트랙 과목 목록 조회·변경 권한 경계 API 전용 ID
LXP_TRACK_ID=
LXP_BOUNDARY_COURSE_ID=

# 게시판 조회·생성 테스트도 위의 공용 LXP_COURSE_ID를 사용한다.

# 학습과목 변경 API 전용 QA 데이터. 운영/공용 데이터 ID를 사용하지 않는다.
LXP_TRACK_ADD_COURSE_ID=
# 변경할 필드만 JSON 객체로 입력한다. 원래 값은 테스트가 실행 직전에 조회하여 자동 복원한다.
# 동시 실행 시 충돌할 수 있으므로 변경 테스트는 팀 내 한 명만 실행한다.
# Jenkins는 로컬 .env를 읽지 않으므로 아래 두 값도 Job 환경변수 또는 Jenkinsfile에 별도로 등록한다.
# TC88: 과목 설명을 임시 변경한 뒤 실행 직전 값으로 자동 복원한다.
LXP_COURSE_EDIT_PATCH_JSON={"description":"[QA-AUTO] temporary course edit"}
# TC89: 수업 설명을 임시 변경한 뒤 실행 직전 값으로 자동 복원한다.
LXP_LECTURE_EDIT_PATCH_JSON={"description":"[QA-AUTO] temporary lecture edit"}
# TC91·TC92의 응답/응시 기록 초기화는 일반 MR에서 실행하지 않는다.
LXP_ALLOW_IRREVERSIBLE_TEST_RESET=false


# --------------------------------------------------
# 5. Part 2 JMeter 시험 사이클 부하 테스트
# --------------------------------------------------

# 현재 실행기는 아래 승인 대상을 코드 allowlist로도 고정한다. 운영/다른 QA 데이터로 변경하지 않는다.
# 환경변수 값을 변경해도 실행기의 승인 대상 검증을 우회할 수 없다.
LXP_PERF_TARGET_WEB_URL=https://dev-qatrack-web.dev.elicer.io/classrooms/28f79a10-c14b-4531-9feb-53d9a5c157fc/courses/727/lectures/1581
LXP_PERF_COURSE_ID=727
LXP_PERF_LECTURE_ID=1581

# 제공받은 30개 QA 계정 CSV의 로컬 절대 경로. CSV 자체는 절대 커밋하지 않는다.
LXP_PERF_ACCOUNT_CSV=

# 예: C:\Users\사용자명\Downloads\apache-jmeter-5.6.3\bin\jmeter.bat
JMETER_BIN=


# --------------------------------------------------
# 6. 안전 설정
# --------------------------------------------------

# 실제 제출/생성/수정 테스트는 QA 전용 계정과 데이터 초기화 여부를 확인한 뒤 true로 변경한다.
LXP_ALLOW_MUTATING_REQUESTS=false

# 선택 사항: 테스트 순서를 재현 가능하게 섞을 때 사용할 정수 seed
PYTEST_RANDOM_ORDER_SEED=

# 게시글 삭제 API가 확정되기 전에는 비워 둔다. 비어 있으면 게시판 생성 테스트를 건너뛴다.
# 형식 예시(실제 경로는 API 담당자 확인 후 입력): /org/{org}/board/article/delete/
LXP_BOARD_ARTICLE_DELETE_PATH=
