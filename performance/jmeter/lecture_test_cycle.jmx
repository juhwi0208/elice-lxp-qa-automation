          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
def code = prev?.getResponseCode() ?: ''
if (code ==~ /5\d\d/) {
    log.error("KILL SWITCH: HTTP ${code} detected at ${prev.getSampleLabel()}. Stop test NOW.")
    props.put('QA6_KILL_SWITCH', "HTTP ${code} @ ${prev.getSampleLabel()}")
    ctx.getEngine().stopTest(true)
}
</stringProp>
