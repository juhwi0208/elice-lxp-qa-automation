            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Token exists" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">
def token = vars.get('access_token')
if (!token || token == 'TOKEN_NOT_FOUND') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('로그인 응답에서 access_token을 추출하지 못했습니다.')
}
</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">false</stringProp>
            </JSR223Assertion>
