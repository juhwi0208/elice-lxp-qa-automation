<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="QA Lecture Test Low-Load Cycle">
      <stringProp name="TestPlan.comments">QA6 Part2 허용 시나리오 전용. Dev/academy/course 727/lecture 1581. Thread별 CSV 계정 1회 고정 할당 → 로그인 1회 → course 조회 → enter → start → stop → reset, 동작 사이 3~5초 pacing, loop 최대 3, 5xx 즉시 중단.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Approved low-load users">
        <stringProp name="ThreadGroup.num_threads">${__P(users,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,1)}</stringProp>
        <longProp name="ThreadGroup.duration">540</longProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptestnow</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Max 3 cycles">
          <stringProp name="LoopController.loops">${__P(loops,1)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CookieManager guiclass="CookiePanel" testclass="CookieManager" testname="HTTP Cookie Manager" enabled="true">
          <collectionProp name="CookieManager.cookies" />
          <boolProp name="CookieManager.clearEachIteration">false</boolProp>
          <boolProp name="CookieManager.controlledByThreadGroup">false</boolProp>
        </CookieManager>
        <hashTree />
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once per virtual user" enabled="true" />
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="00_SAFETY_GUARD" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
def users = (props.get('users') ?: '1') as int
def rampup = (props.get('rampup') ?: '1') as int
def loops = (props.get('loops') ?: '1') as int
def csvPath = props.get('accountsCsv') ?: ''
if (!(users in [1, 5, 10, 20, 30])) {
    throw new IllegalStateException("허용 사용자 수는 smoke 1명 또는 5/10/20/30명뿐입니다: ${users}")
}
if (loops &lt; 1 || loops &gt; 3) {
    throw new IllegalStateException("Loop는 1~3회만 허용됩니다: ${loops}")
}
if (users &gt; 1 &amp;&amp; (rampup &lt; 90 || rampup &gt; 120)) {
    throw new IllegalStateException("5명 이상 부하 단계 Ramp-up은 90~120초여야 합니다: ${rampup}")
}
if (users == 1 &amp;&amp; (rampup &lt; 1 || rampup &gt; 120)) {
    throw new IllegalStateException("1-user smoke Ramp-up은 1~120초여야 합니다: ${rampup}")
}
if (!csvPath) {
    throw new IllegalStateException('accountsCsv가 비어 있습니다.')
}

if (!vars.get('login_id') || !vars.get('password')) {
    throw new IllegalStateException('Thread별 계정 1회 할당에 실패했습니다.')
}
</stringProp>
          </JSR223Sampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="00_ACCOUNT_ASSIGN_ONCE" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters" />
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def csvPath = props.get('accountsCsv') ?: ''
if (!csvPath) {
    throw new IllegalStateException('accountsCsv가 비어 있습니다.')
}

def parseCsvLine = { String line -&gt;
    def values = []
    def current = new StringBuilder()
    boolean quoted = false
    for (int i = 0; i &lt; line.length(); i++) {
        char ch = line.charAt(i)
        if (ch == '"') {
            if (quoted &amp;&amp; i + 1 &lt; line.length() &amp;&amp; line.charAt(i + 1) == '"') {
                current.append('"')
                i++
            } else {
                quoted = !quoted
            }
        } else if (ch == ',' &amp;&amp; !quoted) {
            values.add(current.toString())
            current.setLength(0)
        } else {
            current.append(ch)
        }
    }
    values.add(current.toString())
    return values
}

def file = new File(csvPath)
if (!file.isFile()) {
    throw new IllegalStateException("계정 CSV를 찾을 수 없습니다: ${csvPath}")
}
def lines = file.readLines('UTF-8')
if (lines.size() &lt; 2) {
    throw new IllegalStateException('계정 CSV에 데이터 행이 없습니다.')
}
def header = lines[0].replace('\uFEFF', '').trim()
if (header != 'login_id,password') {
    throw new IllegalStateException("계정 CSV 헤더가 올바르지 않습니다: ${header}")
}
def dataLines = lines.drop(1).findAll { it != null &amp;&amp; !it.trim().isEmpty() }
def accountIndex = ctx.getThreadNum()
if (accountIndex &gt;= dataLines.size()) {
    throw new IllegalStateException("Thread ${accountIndex + 1}에 배정할 계정이 없습니다. CSV 계정 수=${dataLines.size()}")
}
def fields = parseCsvLine(dataLines[accountIndex])
if (fields.size() != 2 || !fields[0]?.trim() || !fields[1]) {
    throw new IllegalStateException("CSV ${accountIndex + 2}행의 login_id/password 형식이 올바르지 않습니다.")
}
vars.put('login_id', fields[0].trim())
vars.put('password', fields[1])
vars.put('account_row', String.valueOf(accountIndex + 2))</stringProp>
            </JSR223PreProcessor>
            <hashTree />
          </hashTree>
